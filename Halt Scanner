<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Halt Scanner — @unholybias</title>
<meta name="description" content="Live trading halt and resume feed, streamed in real time.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root{
    --void:#08080a;
    --panel:#111114;
    --panel-2:#17171b;
    --line:#242429;
    --line-soft:rgba(255,255,255,0.05);
    --amber:#f2a53d;
    --amber-hi:#ffc670;
    --amber-dim:#8a611a;
    --amber-soft:rgba(242,165,61,0.1);
    --ink:#ece9e2;
    --dim:#82818c;
    --dim-2:#4c4c54;
    --bull:#3ecf8e;
    --bull-soft:rgba(62,207,142,0.1);
    --bear:#e5484d;
    --bear-soft:rgba(229,72,77,0.1);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background:var(--void); color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    overflow-x:hidden; -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  ::selection{background:var(--amber); color:var(--void);}
  a{color:inherit; text-decoration:none;}
  ::-webkit-scrollbar{width:10px;}
  ::-webkit-scrollbar-track{background:var(--void);}
  ::-webkit-scrollbar-thumb{background:var(--line); border-radius:6px;}

  .grid-bg{
    position:fixed; inset:0; z-index:0; pointer-events:none;
    background-image:
      linear-gradient(rgba(242,165,61,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(242,165,61,0.02) 1px, transparent 1px);
    background-size:48px 48px;
    mask-image:radial-gradient(ellipse 80% 55% at 50% 15%, black, transparent);
  }

  header{
    position:fixed; top:0; left:0; right:0; z-index:50;
    display:flex; align-items:center; justify-content:space-between;
    padding:16px clamp(20px, 5vw, 56px);
    background:rgba(8,8,10,0.72);
    backdrop-filter:blur(12px);
    border-bottom:1px solid var(--line-soft);
  }
  .header-left{display:flex; align-items:center; gap:16px; position:relative;}

  .hamburger{
    width:34px; height:34px;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:5px;
    background:transparent; border:1px solid var(--line);
    border-radius:4px; cursor:pointer;
    transition:border-color .2s ease, background .2s ease;
  }
  .hamburger:hover{border-color:var(--dim-2); background:rgba(255,255,255,.03);}
  .hamburger span{
    display:block; width:16px; height:1.5px; background:var(--ink);
    transition:transform .2s ease, opacity .2s ease;
  }
  .hamburger.open span:nth-child(1){transform:translateY(6.5px) rotate(45deg);}
  .hamburger.open span:nth-child(2){opacity:0;}
  .hamburger.open span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg);}

  .menu-panel{
    position:absolute; top:calc(100% + 12px); left:0;
    min-width:220px;
    background:var(--panel); border:1px solid var(--line);
    border-radius:6px; overflow:hidden;
    box-shadow:0 20px 40px -16px rgba(0,0,0,.6);
    opacity:0; visibility:hidden; transform:translateY(-6px);
    transition:opacity .18s ease, transform .18s ease, visibility .18s;
  }
  .menu-panel.open{opacity:1; visibility:visible; transform:translateY(0);}
  .menu-panel a{
    display:flex; align-items:center; justify-content:space-between;
    padding:13px 16px;
    font-family:'IBM Plex Mono', monospace; font-size:12.5px;
    color:var(--ink); letter-spacing:0.03em;
    border-bottom:1px solid var(--line-soft);
    transition:background .15s ease, color .15s ease;
  }
  .menu-panel a:last-child{border-bottom:none;}
  .menu-panel a:hover{background:rgba(242,165,61,0.06); color:var(--amber);}
  .menu-panel a .tick{
    width:6px; height:6px; border-radius:50%; background:var(--bull);
    box-shadow:0 0 6px var(--bull); opacity:0;
  }
  .menu-panel a.is-live .tick{opacity:1;}

  .logo{
    font-family:'IBM Plex Mono', monospace;
    font-weight:600; font-size:14px; letter-spacing:0.02em;
    display:flex; align-items:center; gap:9px;
  }
  .logo::before{
    content:''; width:6px; height:6px; border-radius:50%;
    background:var(--bull); box-shadow:0 0 8px var(--bull);
    animation:pulse 2.2s ease-in-out infinite;
  }
  .logo span{color:var(--amber);}
  .nav-cta{
    font-family:'IBM Plex Mono', monospace;
    font-size:11.5px; letter-spacing:0.07em; text-transform:uppercase;
    border:1px solid var(--amber-dim);
    padding:8px 16px; color:var(--amber); border-radius:2px;
    transition:all .2s ease;
  }
  .nav-cta:hover{background:var(--amber-soft); border-color:var(--amber);}

  @keyframes pulse{0%,100%{opacity:1;} 50%{opacity:.3;}}

  main{position:relative; z-index:2; max-width:1180px; margin:0 auto; padding:130px clamp(20px,5vw,56px) 100px;}

  .page-eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:11.5px; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--amber); margin-bottom:14px;
    display:flex; align-items:center; gap:10px;
  }
  .status-dot{
    width:6px; height:6px; border-radius:50%; background:var(--dim-2);
    transition:background .3s ease, box-shadow .3s ease;
  }
  .status-dot.connected{background:var(--bull); box-shadow:0 0 8px var(--bull); animation:pulse 2s ease-in-out infinite;}
  .status-dot.error{background:var(--bear); box-shadow:0 0 8px var(--bear);}

  h1{
    font-family:'IBM Plex Mono', monospace; font-weight:700;
    font-size:clamp(28px, 4.5vw, 44px); line-height:1.1;
    letter-spacing:-0.015em; margin-bottom:16px;
  }
  .page-sub{color:var(--dim); max-width:60ch; line-height:1.65; font-size:15px; margin-bottom:44px;}

  .filter-row{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:28px;}
  .filter-input{
    font-family:'IBM Plex Mono', monospace; font-size:13px;
    background:var(--panel); border:1px solid var(--line); color:var(--ink);
    padding:10px 14px; border-radius:4px; letter-spacing:0.03em;
    outline:none; min-width:180px;
  }
  .filter-input::placeholder{color:var(--dim-2);}
  .filter-input:focus{border-color:var(--amber-dim);}

  .halt-table{
    border:1px solid var(--line); border-radius:6px; overflow:hidden;
    background:var(--panel);
  }
  .halt-head, .halt-row{
    display:grid;
    grid-template-columns:110px 90px 1fr 170px;
    gap:16px; align-items:center;
    padding:16px 20px;
  }
  .halt-head{
    font-family:'IBM Plex Mono', monospace; font-size:10.5px;
    color:var(--dim); text-transform:uppercase; letter-spacing:0.08em;
    border-bottom:1px solid var(--line);
  }
  .halt-row{
    border-bottom:1px solid var(--line-soft);
    font-family:'IBM Plex Mono', monospace; font-size:13px;
    transition:background .5s ease;
  }
  .halt-row:last-child{border-bottom:none;}
  .halt-row.flash{background:var(--amber-soft);}
  .halt-ticker{font-weight:600; font-size:14px; font-family:'IBM Plex Sans', sans-serif;}
  .halt-tag{
    font-size:10.5px; padding:3px 9px; border-radius:2px; font-weight:600;
    letter-spacing:0.04em; width:fit-content; text-transform:uppercase;
  }
  .halt-tag.halt{color:var(--bear); border:1px solid rgba(229,72,77,0.35); background:var(--bear-soft);}
  .halt-tag.resume{color:var(--bull); border:1px solid rgba(62,207,142,0.35); background:var(--bull-soft);}
  .halt-tag.other{color:var(--amber); border:1px solid rgba(242,165,61,0.35); background:var(--amber-soft);}
  .halt-reason{color:var(--dim); font-size:12.5px;}
  .halt-time{color:var(--dim); text-align:right; font-size:12px;}

  @media (max-width:720px){
    .halt-head{display:none;}
    .halt-row{grid-template-columns:1fr 1fr; row-gap:6px;}
    .halt-reason{grid-column:1 / -1;}
    .halt-time{text-align:left;}
  }

  .empty-note{color:var(--dim); font-size:14px; padding:40px 20px; text-align:center; font-style:italic;}

  footer{
    border-top:1px solid var(--line);
    padding:32px clamp(20px,5vw,56px);
    display:flex; justify-content:space-between; align-items:center;
    font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--dim);
    flex-wrap:wrap; gap:12px;
  }

  a:focus-visible, button:focus-visible{outline:2px solid var(--amber); outline-offset:2px;}
</style>
</head>
<body>

<div class="grid-bg"></div>

<header>
  <div class="header-left">
    <button class="hamburger" id="hamburgerBtn" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <div class="logo">@unholy<span>bias</span></div>

    <nav class="menu-panel" id="menuPanel">
      <a href="index.html">Home</a>
      <a href="index.html#framework">Framework</a>
      <a href="halt-scanner.html" class="is-live"><span>Halt Scanner</span><span class="tick"></span></a>
      <a href="https://x.com/unholybias" target="_blank" rel="noopener">Follow on X</a>
    </nav>
  </div>
  <a href="https://x.com/unholybias" target="_blank" rel="noopener" class="nav-cta">Follow</a>
</header>

<main>
  <div class="page-eyebrow">
    <span class="status-dot" id="statusDot"></span>
    <span id="statusText">Connecting…</span>
  </div>
  <h1>Halt Scanner</h1>
  <p class="page-sub">Every trading halt and resume, streamed straight from the tape the moment it prints — regulatory (news-pending) and volatility (LULD) halts alike.</p>

  <div class="filter-row">
    <input type="text" class="filter-input" id="symbolFilter" placeholder="Filter by symbol (e.g. AAPL)">
  </div>

  <div class="halt-table">
    <div class="halt-head">
      <span>Symbol</span>
      <span>Status</span>
      <span>Reason</span>
      <span style="text-align:right;">Time</span>
    </div>
    <div id="haltRows"></div>
  </div>
</main>

<footer>
  <span>@unholybias</span>
  <span>Not financial advice. Trade your own plan.</span>
</footer>

<script>
  const SUPABASE_URL = "https://hgespspgadbyhgcainlr.supabase.co";
  const SUPABASE_ANON_KEY = "sb_publishable_JRuw3y-lQ0YuzpwKxPyyIQ_5RbWQYu0";

  const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  // Hamburger menu
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const menuPanel = document.getElementById('menuPanel');
  function closeMenu(){
    hamburgerBtn.classList.remove('open');
    hamburgerBtn.setAttribute('aria-expanded', 'false');
    menuPanel.classList.remove('open');
  }
  function toggleMenu(){
    const isOpen = menuPanel.classList.toggle('open');
    hamburgerBtn.classList.toggle('open', isOpen);
    hamburgerBtn.setAttribute('aria-expanded', String(isOpen));
  }
  hamburgerBtn.addEventListener('click', (e) => { e.stopPropagation(); toggleMenu(); });
  document.addEventListener('click', (e) => {
    if (!menuPanel.contains(e.target) && !hamburgerBtn.contains(e.target)) closeMenu();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });

  // ── Halt feed ──
  const rowsEl = document.getElementById('haltRows');
  const statusDot = document.getElementById('statusDot');
  const statusText = document.getElementById('statusText');
  const symbolFilter = document.getElementById('symbolFilter');

  let allHalts = [];

  function classify(statusCode){
    if (!statusCode) return 'other';
    const c = statusCode.toUpperCase();
    if (c === 'T' || c === 'R') return 'resume';
    if (c === 'H') return 'halt';
    return 'other';
  }

  function fmtTime(iso){
    if (!iso) return '—';
    const d = new Date(iso);
    return d.toLocaleTimeString('en-US', { hour: '2-digit', minute:'2-digit', second:'2-digit', hour12:false });
  }

  function render(){
    const query = symbolFilter.value.trim().toUpperCase();
    const filtered = query ? allHalts.filter(h => (h.symbol || '').toUpperCase().includes(query)) : allHalts;

    if (filtered.length === 0){
      rowsEl.innerHTML = '<p class="empty-note">No halts yet. This fills in the moment the scanner catches one on the tape.</p>';
      return;
    }

    rowsEl.innerHTML = filtered.slice(0, 100).map(h => `
      <div class="halt-row" data-id="${h.id}">
        <span class="halt-ticker">${h.symbol || '—'}</span>
        <span class="halt-tag ${classify(h.status_code)}">${h.status_message || h.status_code || '—'}</span>
        <span class="halt-reason">${h.reason_message || h.reason_code || ''}</span>
        <span class="halt-time">${fmtTime(h.event_time || h.received_at)}</span>
      </div>
    `).join('');
  }

  symbolFilter.addEventListener('input', render);

  async function loadInitial(){
    const { data, error } = await sb
      .from('halts')
      .select('*')
      .order('event_time', { ascending: false })
      .limit(100);

    if (error){
      statusText.textContent = 'Feed unavailable';
      statusDot.className = 'status-dot error';
      rowsEl.innerHTML = '<p class="empty-note">Halt feed loads once the scanner is connected.</p>';
      return;
    }

    allHalts = data || [];
    render();
  }

  function subscribeRealtime(){
    sb.channel('halts-feed')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'halts' }, (payload) => {
        allHalts.unshift(payload.new);
        render();
        const row = rowsEl.querySelector(`[data-id="${payload.new.id}"]`);
        if (row){
          row.classList.add('flash');
          setTimeout(() => row.classList.remove('flash'), 1200);
        }
      })
      .subscribe((status) => {
        if (status === 'SUBSCRIBED'){
          statusDot.className = 'status-dot connected';
          statusText.textContent = 'Live';
        } else if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT'){
          statusDot.className = 'status-dot error';
          statusText.textContent = 'Reconnecting…';
        }
      });
  }

  function logPageView(){
    try {
      let visitorId = localStorage.getItem('ub_visitor_id');
      if (!visitorId){
        visitorId = (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random().toString(16).slice(2));
        localStorage.setItem('ub_visitor_id', visitorId);
      }
      sb.from('page_views').insert({ visitor_id: visitorId, path: location.pathname }).then(() => {});
    } catch (e) { /* analytics should never break the page */ }
  }

  loadInitial();
  subscribeRealtime();
  logPageView();
</script>

</body>
</html>
